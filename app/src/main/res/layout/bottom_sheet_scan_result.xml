<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        style="@style/TextAppearance.ProScan.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_result" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/result_format"
            style="@style/TextAppearance.ProScan.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/result_engine"
            style="@style/TextAppearance.ProScan.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxHeight="240dp"
        android:fillViewport="false">
        <TextView
            android:id="@+id/result_content"
            style="@style/TextAppearance.ProScan.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result_content"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>

    <Button
        android:id="@+id/button_primary_result"
        style="@style/Widget.ProScan.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/open_link" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/button_copy_result"
            style="@style/Widget.ProScan.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/copy_content" />
        <Button
            android:id="@+id/button_done_result"
            style="@style/Widget.ProScan.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/done" />
    </LinearLayout>
</LinearLayout>
