<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/title_main"
            style="@style/TextAppearance.ProScan.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonHistory"
            style="@style/Widget.ProScan.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/history_title"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subtitle_main"
            style="@style/TextAppearance.ProScan.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_main" />

        <LinearLayout
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_engine_pill_light"
            android:clickable="true"
            android:contentDescription="@string/switch_engine"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle_main">
            <TextView
                android:id="@+id/text_engine_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/textTitle">
            <TextView
                style="@style/TextAppearance.ProScan.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_input_label" />
            <EditText
                android:id="@+id/editTextUrl"
                style="@style/TextAppearance.ProScan.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/home_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="7"
                android:minHeight="112dp"
                android:scrollbars="vertical"
                android:textColorHint="@color/text_tertiary"
                android:textSize="17sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonScan"
            style="@style/Widget.ProScan.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="@string/scan_action"
            app:layout_constraintTop_toBottomOf="@id/inputCard" />

        <LinearLayout
            android:id="@+id/secondary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/buttonScan">
            <Button
                android:id="@+id/buttonPaste"
                style="@style/Widget.ProScan.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/paste_action" />
            <Button
                android:id="@+id/btnVisit"
                style="@style/Widget.ProScan.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/visit_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/secondary_actions">
            <Button
                android:id="@+id/btnBarcode"
                style="@style/Widget.ProScan.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/generate_barcode"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnQRCode"
                style="@style/Widget.ProScan.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/generate_qrcode"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
